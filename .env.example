# LearnHub Environment Configuration Template
# Copy this file to .env.local and populate with your environment-specific credentials.
# Do not commit real credentials or secrets to version control.

# MongoDB connection URI (e.g. MongoDB Atlas cluster or local MongoDB instance)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/learnhub?retryWrites=true&w=majority

# Cryptographically random secret used to sign session JWTs (minimum 32 characters; e.g. `openssl rand -hex 32`)
SESSION_SECRET=your-random-secret-key-at-least-32-bytes-long

# Node runtime environment (development, production, or test)
NODE_ENV=development
